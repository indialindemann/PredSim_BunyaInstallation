# Site: UQ RCC Bunya HPC (RHEL 9, Lmod/EasyBuild modules, Slurm).
#
# Hooks and variables: see sites/ubuntu-local.env for the full list.
#
# Bunya specifics handled here:
#  * MATLAB R2023b bundles libstdc++ only up to GLIBCXX_3.4.28 (gcc 10), but
#    every Bunya gcc module is newer (11.3 -> 3.4.29, 12.3 -> 3.4.30). So MATLAB
#    gets the toolchain's libstdc++/libgcc_s preloaded (PREDSIM_MATLAB_LD_PRELOAD,
#    applied by linux/run_predsim.sh to the MATLAB process only). libstdc++ is
#    backward compatible, so MATLAB itself is unaffected.
#  * The gcc-12.3 toolchain only has OpenBLAS 0.3.23 (MUMPS bug), so OpenBLAS
#    0.3.32 is built (steps/openblas.sh).
#  * Partition 'general' mixes AMD Zen3 (7643), Zen4 (9454) and Zen5 (9745)
#    nodes: optimise for Zen3 (runs on all), tune for Zen4. -march=znver4
#    would crash with SIGILL on the Zen3 nodes.
#  * CMake installs into lib64 on RHEL.
#  * Modules resolve to a per-CPU software tree (/sw/auto/rocky9a/epyc3|4|5/).
#    Zen3 builds run on Zen4/5, not the reverse, so everything is built on an
#    epyc3 node and the one install runs on every node. At run time `module load`
#    picks the node's own module tree.
#  * Benchmarked 2026-11-02 (80-iteration PredSim run, prebuilt CasADi, 2 repeats):
#      s/iteration: epyc4 (9454) 6.8, epyc3 (7643) 8.2, epyc5 (9745) 9.6
#    -> epyc4 nodes are fastest (the solve is single-threaded while PredSim's
#       solve_NLPSOL uses expand=true), so run jobs --prefer=epyc4.
#    Prebuilt is the default here. Source-mode timings from that date are void:
#    MUMPS linked to the pthreads OpenBLAS got BLAS argument errors and
#    diverged (fixed 2026-11-03, steps/ipopt.sh). See BENCHMARKS.md.

# CPU generation of this node, from the EPYC model number (7xx3/9xx4/9xx5).
bunya_arch() {
    local m; m="$(grep -m1 'model name' /proc/cpuinfo)"
    case "$m" in
        *"EPYC 7"??"3"*) echo epyc3 ;;
        *"EPYC 9"??"4"*) echo epyc4 ;;
        *"EPYC 9"??"5"*) echo epyc5 ;;
        *) echo unknown ;;
    esac
}
BUNYA_ARCH="$(bunya_arch)"
SITE_VARIANT="epyc3"                # stack id tag: built on/for epyc3, runs on all nodes
SITE_CASADI_MODE_DEFAULT="prebuilt" # fastest or tied on every node type (see above)

SITE_DESC="UQ Bunya HPC ($BUNYA_ARCH node): RHEL 9, gcc/12.3.0, MATLAB R2023b5, Slurm"
SITE_JOBS="${SITE_JOBS:-${SLURM_CPUS_PER_TASK:-4}}"
SITE_OPT_FLAGS="-O3 -march=znver3 -mtune=znver3 -fPIC"   # source mode only; runs on all nodes
SITE_BUILD_OPENBLAS=1
SITE_ALLOW_NEWER_LIBSTDCXX=1

SITE_MODULES_BUILD="gcc/12.3.0 metis/5.1.0-gcccore-12.3.0 python/3.11.3-gcccore-12.3.0 java/21.0.8 matlab/R2023b5"
SITE_MODULES_RUN="gcc/12.3.0 python/3.11.3-gcccore-12.3.0 matlab/R2023b5"   # python: the venv links the module's libpython

# Defaults for linux/run_predsim.sh --slurm, same as bunya/run_predsim.slurm.
PREDSIM_SBATCH_ARGS="--partition=general --prefer=epyc4 --nodes=1 --ntasks=1 --cpus-per-task=2 --mem=16G --time=7-00:00:00"

_bunya_modules() {
    command -v module >/dev/null 2>&1 || source /etc/profile >/dev/null 2>&1
    module -q purge
    # shellcheck disable=SC2086
    module -q load $1 || { echo "module load failed: $1" >&2; return 1; }
}

site_toolchain() {
    _bunya_modules "$SITE_MODULES_BUILD"
    module -q unload java 2>/dev/null; module -q load java/21.0.8   # javac for OpenSim's Java bindings
    export CC="$(command -v gcc)" CXX="$(command -v g++)" FC="$(command -v gfortran)"
    export MATLAB_ROOT
    MATLAB_ROOT="$(dirname "$(dirname "$(readlink -f "$(command -v matlab)")")")"
    export JAVA_HOME="${JAVA_HOME:-$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")}"
    SITE_METIS_CFLAGS="-I$EBROOTMETIS/include"
    SITE_METIS_LFLAGS="-L$EBROOTMETIS/lib -Wl,-rpath,$EBROOTMETIS/lib -lmetis"
}

site_preflight() {
    [[ "$BUNYA_ARCH" == epyc3 ]] || die "install on an epyc3 node so the result runs on every node (this is $BUNYA_ARCH): sbatch --constraint=epyc3 (bunya/install_predsim.slurm sets this)"
    # Modules resolve to the node's own tree, or fall back to the epyc3 builds
    # (e.g. gcc/12.3.0 on epyc5 nodes). Either runs on this node; a tree newer
    # than the node would not.
    local g; g="$(command -v gcc)"
    [[ "$g" == */rocky9a/$BUNYA_ARCH/* || "$g" == */rocky9a/epyc3/* ]] \
        || die "module tree ($g) is neither this node's CPU ($BUNYA_ARCH) nor epyc3"
    log "Bunya node: $BUNYA_ARCH, flags: $SITE_OPT_FLAGS"
}

# Shared parts must be built on epyc3 so every node can use them.
site_can_build_shared() { [[ "$BUNYA_ARCH" == epyc3 ]]; }

site_python() { command -v python3; }

site_blas_dir() {
    [[ -f "$OPENSIM_PREFIX/openblas/lib/libopenblas.so.0" ]] \
        || { echo "OpenBLAS not built yet ($OPENSIM_PREFIX/openblas)" >&2; return 1; }
    echo "$OPENSIM_PREFIX/openblas/lib"
}

site_matlab_preload_names() {
    # Toolchain runtime libs MATLAB must use instead of its older bundled ones;
    # in source mode our MUMPS also needs the toolchain's newer libgfortran.
    local libs="libstdc++.so.6 libgcc_s.so.1"
    [[ "${CASADI_MODE:-}" == source ]] && libs+=" libgfortran.so.5 libquadmath.so.0"
    echo "$libs"
}

site_runtime_env() {
    cat <<EOF
command -v module >/dev/null 2>&1 || source /etc/profile >/dev/null 2>&1
module -q purge
module -q load $SITE_MODULES_RUN
module -q unload java 2>/dev/null || true   # MATLAB uses its own JVM
export CC="\$(command -v gcc)" CXX="\$(command -v g++)"
# toolchain runtime for MATLAB, from this node's own module tree
export PREDSIM_MATLAB_LD_PRELOAD="\$(for l in $(site_matlab_preload_names); do printf '%s:' "\$(g++ -print-file-name=\$l)"; done | sed 's/:\$//')"
EOF
}
