# Site: local Ubuntu 24.04 workstation ("phoebe").
#
# Every site file defines the same variables and hooks; step scripts only use
# these, never `if bunya ...`.
#
#   SITE_DESC                 one-line description
#   SITE_JOBS                 parallel build jobs
#   SITE_OPT_FLAGS            C/C++/Fortran optimisation flags for speed-critical
#                             source builds (Ipopt/MUMPS/CasADi in source mode)
#   PREDSIM_SBATCH_ARGS       default sbatch args for linux/run_predsim.sh --slurm
#   site_toolchain            put compilers/MATLAB/Java on PATH, export CC CXX FC,
#                             MATLAB_ROOT, JAVA_HOME
#   site_python               echo the python3 used to create the venv
#   site_blas_dir             echo the dir holding libopenblas.so (source mode)
#   SITE_METIS_CFLAGS/LFLAGS  METIS for MUMPS ordering (source mode; empty = none)
#   site_runtime_env          echo extra `export` lines for the runtime env.sh

SITE_DESC="Ubuntu 24.04 workstation, MATLAB R2024b, gcc 12.3 (/opt), spack OpenBLAS"
SITE_JOBS="${SITE_JOBS:-$(nproc)}"
SITE_OPT_FLAGS="-O3 -march=native -fPIC"
PREDSIM_SBATCH_ARGS=""

# MATLAB R2024b ships libstdc++ up to GLIBCXX_3.4.30 (gcc 12). The system gcc 13
# emits 3.4.32, which would force LD_PRELOAD hacks, so build with gcc 12.
SITE_GCC_ROOT="/opt/gcc-12.3.0"
SITE_MATLAB_ROOT="/usr/local/MATLAB/R2024b"
SITE_JAVA_HOME="/usr/lib/jvm/temurin-21-jdk-amd64"
SITE_SPACK="$HOME/spack"
SITE_METIS_CFLAGS="-I/usr/include"     # apt libmetis-dev
SITE_METIS_LFLAGS="-lmetis"

site_toolchain() {
    export PATH="$SITE_GCC_ROOT/bin:$SITE_MATLAB_ROOT/bin:$SITE_JAVA_HOME/bin:$PATH"
    export LD_LIBRARY_PATH="$SITE_GCC_ROOT/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export CC="$SITE_GCC_ROOT/bin/gcc" CXX="$SITE_GCC_ROOT/bin/g++" FC="$SITE_GCC_ROOT/bin/gfortran"
    export MATLAB_ROOT="$SITE_MATLAB_ROOT" JAVA_HOME="$SITE_JAVA_HOME"
}

site_python() {
    # system python3.12 lacks ensurepip (python3.12-venv not installed); the spack
    # python 3.11 matches Bunya's python/3.11 module anyway
    echo "$("$SITE_SPACK/bin/spack" location -i python@3.11.15)/bin/python3"
}

site_blas_dir() {
    # OpenBLAS 0.3.23 has a known MUMPS bug (OpenMathLib/OpenBLAS#4005), use 0.3.32.
    local root
    root="$("$SITE_SPACK/bin/spack" location -i openblas@0.3.32 2>/dev/null)" \
        || { echo "spack openblas@0.3.32 not installed" >&2; return 1; }
    if [[ -f "$root/lib64/libopenblas.so" ]]; then echo "$root/lib64"; else echo "$root/lib"; fi
}

site_runtime_env() {
    # Compiler on PATH at run time: opensimAD compiles new external functions.
    cat <<EOF
export PATH="$SITE_GCC_ROOT/bin:$SITE_MATLAB_ROOT/bin:\$PATH"
export CC="$SITE_GCC_ROOT/bin/gcc" CXX="$SITE_GCC_ROOT/bin/g++"
EOF
}
