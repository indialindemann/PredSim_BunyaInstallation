# Pinned versions for the PredSim Linux stack. Changing anything here gives
# a new stack id (and so a new install prefix); existing stacks are untouched.

# --- PredSim
PREDSIM_REPO="git@github.com:indialindemann/PredSim.git"
PREDSIM_BRANCH="linux/cleancurvev4"

# --- CasADi (keep in step with the Windows install in cleancurvev4 main.m)
CASADI_VERSION="3.8.2"
# prebuilt: official linux64-matlab2018b package (bundled Ipopt/MUMPS/OpenBLAS)
# source:   casadi-source-v<ver>.zip (SWIG wrappers pre-generated, so no SWIG
#           needed) built with site optimisation flags against our own Ipopt
CASADI_MODE_DEFAULT="prebuilt"

# --- Ipopt + MUMPS (only built for CASADI_MODE=source)
IPOPT_TAG="releases/3.14.19"
MUMPS_TP_TAG="releases/3.0.14"     # coin-or-tools/ThirdParty-Mumps

# --- OpenSim (Windows users run the 4.5 installer)
OPENSIM_TAG="4.5.2"
SWIG_OPENSIM_VERSION="4.1.1"       # upstream SWIG, for OpenSim's Java bindings only
OPENSIM_MODELS_REF="d9b05d470b1a481c222372c85b75772faf8f7792"   # Geometry folder

# --- opensimAD prebuilt recorder libraries (used by PredSim/opensimAD_linux)
OPENSIMAD_URL="https://sourceforge.net/projects/opensimad/files/linux.tar.gz/download"

# --- Python packages for the venv (opensimAD's genF.py, cmake for runtime builds)
PY_PACKAGES="numpy scipy cmake==3.31.6 patchelf==0.17.2.1 casadi==${CASADI_VERSION}"
